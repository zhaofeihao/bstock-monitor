{
  "name": "binance-bstock-arbitrage-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time Binance bStocks and PancakeSwap V3 price divergence monitor",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "check:live": "tsx src/cli/live-check.ts",
    "check:feishu": "tsx src/cli/test-feishu.ts",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "npm run build && pm2 reload ecosystem.config.cjs --env production --update-env",
    "pm2:logs": "pm2 logs bstock-monitor",
    "pm2:stop": "pm2 stop bstock-monitor"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "pino": "^10.3.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
