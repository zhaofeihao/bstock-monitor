# Runtime
NODE_ENV=production
LOG_LEVEL=info
HTTP_HOST=127.0.0.1
HTTP_PORT=8787

# Binance public market data
BSTOCK_ASSET_URL=https://www.binance.com/bapi/asset/v2/public/asset/asset/get-tokenised-asset
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_QUOTE_ASSET=USDT

# Optional. Enables deposit/withdraw status and withdrawal fee checks.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# BNB Smart Chain and PancakeSwap V3
BSC_RPC_URL=https://bsc-dataseed.binance.org
# Optional: a reliable WSS endpoint enables zero-RPC Swap-event fast-path updates.
BSC_WSS_URL=
PANCAKE_V3_FACTORY=0x0BFbCF9fa4f9C56B0F40a671Ad40E0805A091865
PANCAKE_V3_QUOTER=0xB048Bbc1Ee6b733FFfCFb9e9CeF7375518e25997
BSC_USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11
PANCAKE_V3_FEES=100,500,2500,10000

# Detection. 1000 means simulate each route with roughly 1000 USDT.
NOTIONAL_USD=1000
ALERT_THRESHOLD_BPS=50
PREQUOTE_THRESHOLD_BPS=10
MIN_PROFIT_USD=1
CEX_TAKER_FEE_BPS=10
# Binance Spot BUY commission is normally deducted from received base unless BNB/quote-fee payment is enabled.
CEX_BUY_FEE_ASSET=base
EXECUTION_BUFFER_BPS=5
ESTIMATED_GAS_COST_USD=0.20
REBALANCE_COST_USD=0
SETTLEMENT_MODE=prepositioned

# Freshness and cadence
DEX_POLL_INTERVAL_MS=1000
DETECTION_INTERVAL_MS=250
EXACT_QUOTE_MIN_INTERVAL_MS=1000
EXACT_QUOTE_TIMEOUT_MS=3000
MAX_LEG_DRIFT_BPS=5
MAX_PRICE_AGE_MS=5000
# SQLite sampling only; detection still runs at DETECTION_INTERVAL_MS.
SNAPSHOT_INTERVAL_MS=30000
ASSET_REFRESH_MS=3600000
POOL_REFRESH_MS=900000
TRANSFER_STATUS_REFRESH_MS=60000
MULTIPLIER_REFRESH_MS=60000
ALERT_COOLDOWN_MS=30000
MIN_RELATIVE_POOL_LIQUIDITY_BPS=100

# Persistence and notification
SQLITE_PATH=./data/bstock-monitor.db
RETENTION_DAYS=14
WEBHOOK_URL=

# Feishu custom bot. The secret is optional unless signature verification is enabled in Feishu.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
# Keep the configured Feishu security keyword in this title when keyword verification is enabled.
FEISHU_MESSAGE_TITLE=bStock 套利机会
FEISHU_AT_ALL=false
